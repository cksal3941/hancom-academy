rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 이메일 목록 — .env의 VITE_ADMIN_EMAILS와 반드시 동기화하세요.
    // 클라이언트 코드의 isAdminUser()는 UI 노출만 제어하며,
    // 실제 쓰기 권한은 이 규칙이 결정합니다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'cksal8449@gmail.com'
        ];
    }

    // 조회수(views) 필드만 변경하는 업데이트인지 검사.
    // 비로그인 방문자도 상세 페이지에서 조회수를 올릴 수 있어야 한다.
    function isViewsIncrementOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.views + 1;
    }

    // 공지사항 — 목록/상세 모두 로그인 필요 (앱 라우터의 ProtectedRoute와 일치)
    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && isViewsIncrementOnly());
    }

    // 개강소식 — 공개 게시판
    match /opening-notices/{openingNoticeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isViewsIncrementOnly();
    }

    // 뉴스 — 공개 게시판
    match /news/{newsId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isViewsIncrementOnly();
    }

    // 그 외 모든 문서는 접근 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
